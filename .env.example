# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# LLM inference via OpenRouter
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Public timetable page the agent scrapes through Playwright MCP.
# Real target confirmed live (ticket B0): README.md "Setup" section, not here.
SCHEDULE_URL=https://example.university.edu/schedule
# CSS selector of the timetable container on that page. This default matches
# the recorded offline fixtures (fixtures/playwright/schedule_page_v*.html),
# which use a plain <table class="schedule">.
#
# The real confirmed target, schedule.kse.ua, does NOT use a table at all -
# it's a CSS grid of `.schedule-event-card` divs, one per class session, and
# it only renders sessions after a discipline is chosen in its search box
# (there is no default full-timetable view). mcp_servers/schedule_mcp/domain/
# parser.py auto-detects this: if no element matches SCHEDULE_TABLE_SELECTOR,
# it falls back to parsing `.schedule-event-card` directly, so this variable
# does not need to change for that site. See README.md "Setup" for the
# confirmed URL and docs/playwright-tools.json for the captured contract.
SCHEDULE_TABLE_SELECTOR=table.schedule

# Custom MCP server
SCHEDULE_MCP_COMMAND=python
SCHEDULE_MCP_ARGS=-m mcp_servers.schedule_mcp.server
SCHEDULE_MCP_DATA_DIR=./data
SCHEDULE_MCP_STATE_DIR=./.state

# Offline / replay mode: when true the agent never touches the network and
# reads the recorded page from fixtures/playwright/ instead.
OFFLINE_MODE=false

# Politeness: minimum seconds between two navigations of the same host.
SCRAPE_MIN_INTERVAL_SEC=3
