# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# LLM inference via OpenRouter
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Public timetable page the agent scrapes through Playwright MCP.
# Real target confirmed live (ticket B0): README.md "Setup" section, not here.
# For a real (non-fixture) run, this MUST keep the literal placeholders
# `YYYY-MM-DD` and `<COURSE_CODE>` (see README.md:78 for the confirmed
# value) - PlaywrightTools.capture_full_week (ticket B2b) substitutes them
# per discipline/date and raises ValueError before touching the browser if
# either is missing, rather than navigating the same unfiltered URL once per
# discipline.
SCHEDULE_URL=https://example.university.edu/schedule
# CSS selector of the timetable container on that page. This default matches
# the recorded offline fixtures (fixtures/playwright/schedule_page_v*.html),
# which use a plain <table class="schedule">.
#
# The real confirmed target, schedule.kse.ua, does NOT use a table at all -
# it's a CSS grid of `.schedule-event-card` divs, one per class session, and
# it only renders sessions after a discipline is chosen in its search box
# (there is no default full-timetable view). mcp_servers/schedule_mcp/domain/
# parser.py's own PARSING step auto-detects this: if no element matches
# SCHEDULE_TABLE_SELECTOR, it falls back to reading `.schedule-event-card`
# directly.
#
# Leave this at its default even for a real (non-fixture) run against
# schedule.kse.ua: PlaywrightTools.capture_full_week (ticket B2b) always
# parses with the parser's own default, never with this value, precisely
# because setting it to something KSE-specific like `.schedule-event-card`
# broke live captures (verified: BeautifulSoup then matches a stray card
# `<div>` as "the table" and fails with a confusing "table has no header
# row" instead of ever reaching the grid fallback above). capture_full_week
# also does not use this value to decide when the page is ready - see its
# docstring for the actual (`.schedule-grid-header`) wait condition.
# See README.md "Setup" for the confirmed URL and docs/playwright-tools.json
# for the captured contract.
SCHEDULE_TABLE_SELECTOR=table.schedule

# Custom MCP server
SCHEDULE_MCP_COMMAND=python
SCHEDULE_MCP_ARGS=-m mcp_servers.schedule_mcp.server
SCHEDULE_MCP_DATA_DIR=./data
SCHEDULE_MCP_STATE_DIR=./.state

# Offline / replay mode: when true the agent never touches the network and
# reads the recorded page from fixtures/playwright/ instead.
OFFLINE_MODE=false

# Politeness: minimum seconds between two navigations of the same host.
SCRAPE_MIN_INTERVAL_SEC=3

# How long PlaywrightTools.capture_timetable waits for SCHEDULE_TABLE_SELECTOR
# to render before raising SelectorNeverAppearedError:
# (SELECTOR_POLL_ATTEMPTS - 1) * SELECTOR_POLL_INTERVAL_SEC seconds. Raise
# these for a client-rendered page that takes longer than a static fixture.
SELECTOR_POLL_ATTEMPTS=10
SELECTOR_POLL_INTERVAL_SEC=2
